# Gemini (Google AI Studio). Set a monthly spend cap on the Google side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Web Push keys. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (Vercel Marketplace sets the KV_* names automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for the scheduler that calls /api/cron/tick.
CRON_SECRET=
